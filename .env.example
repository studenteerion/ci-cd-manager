# Application Configuration - Copy this to .env and customize

# Application port (for dev and production)
# Default: 61555
PORT=61555

# APP_MODE: 'testing' = local Mac development (temp/ folder), 'production' = Ubuntu server (/opt/apps)
# Default is 'production' if not set
APP_MODE=production

# Base directory for all teams and system files
APPS_BASE_DIR=/opt/apps

# Users file path (contains username/password for authentication)
# Default: users.json in project root
USERS_FILE=./users.json

# Caddy configuration directory
CADDY_CONF_DIR=/opt/apps/caddy/conf.d

# Webhook configuration
WEBHOOK_SCRIPTS_DIR=/opt/apps/webhook/scripts
WEBHOOK_HOOKS_FILE=/opt/apps/webhook/hooks.json
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://webhook.example.com

# System commands (customize based on your environment)
# For Ubuntu/Linux with systemd:
CADDY_RELOAD_CMD="systemctl reload caddy"
WEBHOOK_RESTART_CMD="docker compose -f /opt/apps/webhook/docker-compose.yml restart"

# Alternative commands (uncomment if using different setup):
# CADDY_RELOAD_CMD=caddy reload --config /opt/apps/caddy/Caddyfile
# WEBHOOK_RESTART_CMD=systemctl restart webhook-server
